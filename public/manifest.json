{
  "manifest_version": 3,
  "name": "Subline · 双语字幕",
  "version": "0.1.0",
  "description": "观看 YouTube、HBO Max、X（推特）视频时，使用自己的 OpenAI 兼容接口，在原字幕下方显示母语翻译。",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://*.hbo.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subline 双语字幕",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "index.html",
  "content_scripts": [
    {
      "matches": ["https://*.max.com/*", "https://*.hbomax.com/*", "https://*.hbo.com/*"],
      "js": ["hbo-page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://*.max.com/*", "https://*.hbomax.com/*", "https://*.hbo.com/*"],
      "js": ["hbo-content.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
